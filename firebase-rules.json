{
  "rules": {
    "users": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['uid','name','username']) && newData.child('username').val() === $username && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 30"
      }
    },
    "uidToUsername": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid && (!data.exists() || data.val() === newData.val())",
        ".validate": "newData.isString() && root.child('users').child(newData.val()).child('uid').val() === auth.uid"
      }
    },
    "chatIndex": {
      "$username": {
        ".read": "auth != null && root.child('uidToUsername').child(auth.uid).val() === $username",
        "$other": {
          ".write": "auth != null && (root.child('uidToUsername').child(auth.uid).val() === $username || (root.child('chats').child(newData.child('chatId').val()).child('members').child($username).val() === true && root.child('chats').child(newData.child('chatId').val()).child('members').child($other).val() === true && root.child('chats').child(newData.child('chatId').val()).child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true))",
          ".validate": "newData.hasChildren(['chatId','name']) && root.child('chats').child(newData.child('chatId').val()).child('members').child($username).val() === true && root.child('chats').child(newData.child('chatId').val()).child('members').child($other).val() === true"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true && newData.child('members').hasChildren()) || (data.child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true))",
        ".validate": "newData.child('members').hasChildren([root.child('uidToUsername').child(auth.uid).val()])"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true",
        "$messageId": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','text','timestamp']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 2000"
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('callerUid').val() === auth.uid || data.child('calleeUid').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('callerUid').val() === auth.uid) || (data.exists() && (data.child('callerUid').val() === auth.uid || data.child('calleeUid').val() === auth.uid)))"
      }
    },
    "incomingCalls": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$callId": {
          ".write": "auth != null && ($uid === auth.uid || root.child('calls').child($callId).child('callerUid').val() === auth.uid)"
        }
      }
    }
  }
}