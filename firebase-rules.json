{
  "rules": {
    "users": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.child('uid').val() === auth.uid || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid','name','username']) && newData.child('username').val() === $username && newData.child('uid').isString() && newData.child('name').isString()"
      }
    },
    "uidToUsername": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid && (!data.exists() || data.val() === newData.val())"
      }
    },
    "chatIndex": {
      "$username": {
        ".read": "auth != null && root.child('users').child($username).child('uid').val() === auth.uid",
        "$other": {
          ".write": "auth != null && root.child('users').child($username).child('uid').val() === auth.uid && root.child('users').child($other).exists()"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true",
        "members": {
          ".write": "auth != null && !data.exists() && newData.child(root.child('uidToUsername').child(auth.uid).val()).val() === true && newData.hasChildren() && newData.numChildren() === 2",
          ".validate": "newData.hasChildren() && newData.numChildren() === 2"
        },
        "profiles": {
          ".write": "auth != null && !data.exists() && root.child('chats').child($chatId).child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true"
        },
        "updatedAt": {
          ".write": "auth != null && data.parent().parent().child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true"
        }
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true",
        "$messageId": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(root.child('uidToUsername').child(auth.uid).val()).val() === true && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','text','timestamp']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 2000"
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('callerUid').val() === auth.uid || data.child('calleeUid').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && newData.child('callerUid').val() === auth.uid && newData.child('calleeUid').exists()",
        "callerCandidates": {
          "$candidate": {
            ".write": "auth != null && (root.child('calls').child($callId).child('callerUid').val() === auth.uid || root.child('calls').child($callId).child('calleeUid').val() === auth.uid)",
            ".read": "auth != null && (root.child('calls').child($callId).child('callerUid').val() === auth.uid || root.child('calls').child($callId).child('calleeUid').val() === auth.uid)"
          }
        },
        "calleeCandidates": {
          "$candidate": {
            ".write": "auth != null && (root.child('calls').child($callId).child('callerUid').val() === auth.uid || root.child('calls').child($callId).child('calleeUid').val() === auth.uid)",
            ".read": "auth != null && (root.child('calls').child($callId).child('callerUid').val() === auth.uid || root.child('calls').child($callId).child('calleeUid').val() === auth.uid)"
          }
        },
        "answer": {
          ".write": "auth != null && root.child('calls').child($callId).child('calleeUid').val() === auth.uid"
        },
        "status": {
          ".write": "auth != null && (root.child('calls').child($callId).child('callerUid').val() === auth.uid || root.child('calls').child($callId).child('calleeUid').val() === auth.uid)"
        }
      }
    },
    "incomingCalls": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        "$callId": {
          ".write": "auth != null && $uid === root.child('calls').child($callId).child('calleeUid').val()"
        }
      }
    }
  }
}